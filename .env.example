# ---- 大模型 API（三选一起步，后续做路由）----
DEEPSEEK_API_KEY=
QWEN_DASHSCOPE_API_KEY=
GLM_ZHIPU_API_KEY=

# ---- Embedding ----EMBEDDING_MODEL=BGE-M3
EMBEDDING_API_KEY=

# ---- 向量库 ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- 应用 ----
APP_ENV=development
APP_PORT=8000
